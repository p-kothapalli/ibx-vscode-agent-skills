{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Story Dependency Graph",
  "description": "Tracks cross-story relationships: blocking dependencies, shared components, and execution order.",
  "type": "object",
  "required": ["graph_id", "timestamp", "nodes", "edges"],
  "properties": {
    "graph_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "priority", "status"],
        "properties": {
          "id": { "type": "string", "description": "Story ID (e.g., US-1.1)" },
          "title": { "type": "string" },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
          "status": { "type": "string", "enum": ["pending", "in_progress", "done", "blocked"] },
          "epic": { "type": "string" },
          "effort": { "type": "string" },
          "components": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "type"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": { "type": "string", "enum": ["blocks", "depends_on", "shares_component", "parallel"] },
          "shared_component": { "type": "string" }
        }
      }
    }
  }
}
