{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Component Delta",
  "description": "Tracks Salesforce component changes proposed by a user story for deployment pipeline consumption.",
  "type": "object",
  "required": ["story_id", "session_id", "timestamp", "vertical", "components"],
  "properties": {
    "story_id": { "type": "string", "description": "User story identifier (e.g., US-1.1)" },
    "session_id": { "type": "string", "description": "Agent session UUID" },
    "timestamp": { "type": "string", "format": "date-time" },
    "vertical": { "type": "string", "enum": ["PNM", "HLS", "Insurance", "FSC", "CME", "Custom"] },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "action"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["OmniScript", "DataRaptor", "IntegrationProcedure", "ApexClass", "ApexTrigger", "CustomObject", "CustomField", "Picklist", "CustomMetadata", "LWC", "Flow", "PermissionSet", "ValidationRule"] },
          "action": { "type": "string", "enum": ["create", "modify", "delete"] },
          "path": { "type": "string", "description": "File path in force-app/ if known" },
          "details": { "type": "string" }
        }
      }
    }
  }
}
