{
  "servers": {
    "Salesforce DX": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@salesforce/mcp@latest",
        "--orgs",
        "DEFAULT_TARGET_ORG",
        "--toolsets",
        "orgs,metadata,data,users",
        "--tools",
        "run_apex_test",
        "--allow-non-ga-tools"
      ]
    },
    "code-review-graph": {
      "type": "stdio",
      "command": "code-review-graph",
      "args": ["serve"]
    },
    "salesforce-docs": {
      "type": "http",
      "url": "https://api.salesforce.com/sse"
    },
    "user-story-architect": {
      "type": "stdio",
      "command": "python3",
      "args": ["${workspaceFolder}/mcp_server/server.py"]
    }
  }
}
